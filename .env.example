# Planned local demo configuration. No application loads this file yet.
# API-only bootstrap secret: set privately before API startup (ticket 28).
DRIFTGUARD_OPERATOR_TOKEN=

# Node sample/SDK only: populate from operator project/key setup (tickets 29/32).
# Never expose credentials through VITE_* or commit a populated environment file.
DRIFTGUARD_PROJECT_ID=
DRIFTGUARD_API_KEY=
DRIFTGUARD_ENDPOINT=http://127.0.0.1:4000

# Development environment is selected explicitly in SDK config.
# Local HTTP also requires explicit allowInsecureLoopback: true in SDK config.
# API, Vite proxy, and mock control endpoints must bind to loopback.
# Production-labelled keys are a separate scope, not production deployment approval.
